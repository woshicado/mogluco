<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LibreView: fetch the account ID and upload glucose data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Watch mirror: WatchLink's network callback re-establishes the sync and catches up
         readings when connectivity returns (registerNetworkCallback throws without it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- NFC: activate a new Libre3 sensor. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- BLE: receive streaming glucose from the sensor. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-31 BLE scanning required location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Alarms + background sensor connection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Full-screen alarm surface on a locked/off screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Restart the keep-alive service (readings + alarms) after reboot — see BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Override Do Not Disturb" alarm option: lift the interruption filter while ringing
         (the actual capability is the user-granted notification-policy access). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Health Connect: optional one-way export of glucose readings (off by default; the WRITE
         grant is only requested when the user enables the feature in settings). -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />

    <application
        android:name=".MoglucoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mogluco">
        <!-- singleTop: a notification tap resumes the running instance instead of stacking
             another copy (each with its own view models) on top of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mogluco">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect shows this as the permission dialog's privacy-policy link
                 (pre-Android-14 Health Connect APK). -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ Health Connect rationale entry point (opens the app). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Ongoing glucose notification (current reading, trend, mini-graph). Uses the
             special-use FGS type so it starts without a runtime health-permission grant. -->
        <service
            android:name=".notification.GlucoseNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_glucose_monitoring_display" />
        </service>

        <!-- Ringing glucose alarm (looping sound + vibration until dismissed/timeout). -->
        <service
            android:name=".notification.AlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_glucose_monitoring_alarm" />
        </service>

        <!-- Opt-in "true always-on display" overlay. Declaring the service is invisible until the
             user enables it in system Accessibility settings — Android never auto-prompts for it,
             so this scares no one who doesn't want the feature. It hosts a TYPE_ACCESSIBILITY_OVERLAY
             window (no SYSTEM_ALERT_WINDOW needed) and is read-only w.r.t. sensor data. -->
        <service
            android:name=".aod.AodOverlayService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aod_accessibility_config" />
        </service>

        <!-- Restores the keep-alive service after reboot/app update; without it no readings and
             no alarms run until the app is opened. Both actions are system broadcasts, so the
             receiver stays unexported. -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wakes the signal-loss check at its deadline (AlarmManager), so it also fires in Doze. -->
        <receiver
            android:name=".notification.SignalLossReceiver"
            android:exported="false" />

        <!-- Handles the signal-loss notification's Dismiss / Reclaim-sensor action buttons. -->
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <!-- Full-screen alarm shown via full-screen intent when the device is locked/off. -->
        <activity
            android:name=".notification.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Mogluco" />
    </application>

</manifest>
