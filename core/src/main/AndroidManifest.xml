<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Phone ↔ watch Data-Layer receiver (mirror tunnel, sensor transfer, bootstrap).
             Declared here so it merges into BOTH the phone (:app) and watch (:wear) apps —
             the mirror protocol is symmetric. GMS wakes it on incoming messages. -->
        <service
            android:name="tk.glucodata.MessageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/" />
            </intent-filter>
        </service>
    </application>
</manifest>
